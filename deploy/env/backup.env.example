# /etc/pastel/backup.env — konfigurasi backup (root:pastel, 0640).
# Contoh tanpa secret. Kunci akses storage disimpan di /etc/pastel/rclone.conf (lihat deploy-plan.md).

BACKUP_DIR=/var/backups/pastel
# Retensi lokal (hari).
KEEP_DAILY_DAYS=14
KEEP_MONTHLY_DAYS=400
KEEP_PREDEPLOY_DAYS=30

# Salinan ke luar VPS. Kosongkan untuk menonaktifkan (TIDAK disarankan untuk go-live).
# Contoh: remote rclone "pastel-offsite" (crypt di atas R2/B2), folder "pastel".
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/pastel/rclone.conf

# Opsional: URL ping monitor (mis. healthchecks.io). Dianggap rahasia, isi langsung di VPS.
BACKUP_PING_URL=
