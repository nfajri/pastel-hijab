# /etc/pastel/pastel.env — konfigurasi service Pastel (root:pastel, 0640).
# Nama variabel mengikuti backend Go (T-0131); sesuaikan bila README server/ berbeda.
# JANGAN commit file asli ke repo. Berkas ini hanya contoh tanpa secret.

# Hanya dengar di localhost; akses publik lewat reverse proxy (Caddy/nginx).
# Port 8087 sementara: pastikan tidak bentrok (lihat vps-check.sh).
PASTEL_ADDR=127.0.0.1:8087
PASTEL_DB=/var/lib/pastel/pastel.db
PASTEL_COOKIE_SECURE=1
# Percayai X-Forwarded-For hanya dari proxy lokal (rate limit login per IP klien).
PASTEL_TRUST_PROXY=1
