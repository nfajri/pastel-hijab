# Pastel Hijab (pembukuan, stok & pricing): API + frontend statis, satu binary Go.
# Lokasi di VPS: /etc/systemd/system/pastel.service (dipasang oleh deploy/scripts/install.sh).
# Data: /var/lib/pastel (StateDirectory). Log: journald -> `journalctl -u pastel`.
[Unit]
Description=Pastel Hijab (pembukuan, stok & pricing)
Documentation=file:///opt/pastel/deploy/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pastel
Group=pastel
EnvironmentFile=/etc/pastel/pastel.env
ExecStart=/opt/pastel/current/pastel
WorkingDirectory=/var/lib/pastel
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

# Direktori yang dibuat & dimiliki systemd untuk user pastel.
StateDirectory=pastel
StateDirectoryMode=0700
UMask=0077

# Batas sumber daya: VPS dipakai aplikasi lain juga.
MemoryMax=256M
TasksMax=128
LimitNOFILE=4096

# Hardening dasar.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Syscall yang diblokir gagal dengan EPERM, bukan proses dibunuh (Go runtime toleran).
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
